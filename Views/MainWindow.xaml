<Window x:Class="R88.BackupTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:R88.BackupTool"
        xmlns:v="clr-namespace:R88.BackupTool.Views"
        xmlns:vm="clr-namespace:R88.BackupTool.ViewModels"
        mc:Ignorable="d"
        Title="R88 BackupTool" Height="300" Width="500" FontSize="14" 
        ResizeMode="NoResize" SizeToContent="Height">
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <ControlTemplate x:Key="ValidationErrorTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="adornedelem" />
                <TextBlock Foreground="Red" FontSize="12" Text="{Binding AdornedElement.(Validation.Errors)[0].ErrorContent, ElementName=adornedelem}" />
            </StackPanel>
        </ControlTemplate>
        <DataTemplate DataType="{x:Type vm:EmptyViewModel}">
            <Grid />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CDTimerViewModel}">
            <TextBlock Text="{Binding DataContext.CountDownTimer, RelativeSource={RelativeSource AncestorType={x:Type v:MainWindow}}}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupProgressViewModel}">
            <Grid>
                <ProgressBar Minimum="0" Maximum="100" Width="150"
                             Value="{Binding DataContext.ProgressValue, RelativeSource={RelativeSource AncestorType={x:Type v:MainWindow}}}" 
                             IsIndeterminate="{Binding DataContext.ProgressIsBusy, RelativeSource={RelativeSource AncestorType={x:Type v:MainWindow}}}"/>
                <TextBlock Text="{Binding DataContext.ProgressMsg, RelativeSource={RelativeSource AncestorType={x:Type v:MainWindow}}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding SaveAppDataCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="ファイル(_F)">
                    <MenuItem Header="前回のデータをロード" Command="{Binding LoadPreviouseCommand}" />
                    <MenuItem Header="終了(_X)" Command="{Binding ExitCommand}"/>
                </MenuItem>
            </Menu>
            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem HorizontalAlignment="Left">
                    <TextBlock Text="{Binding AppStatus}" />
                </StatusBarItem>
                <Separator Margin="5 0" />
                <StatusBarItem HorizontalAlignment="Right">
                    <ContentControl Content="{Binding CurrentSBControl}" />
                </StatusBarItem>
            </StatusBar>
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
 
 <!--   ++++++++++++ Set Source/Destination Dir +++++++++++++    -->

                <StackPanel Orientation="Vertical" Grid.Row="0" VerticalAlignment="Center" Margin="0 0 0 10">
                    <TextBlock Text="バックアップ元フォルダ："/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}" >
                            <TextBox.Text>
                                <Binding Path="SourcePath" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <vm:NotUncValidationRule ValidatesOnTargetUpdated="True" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <Button Grid.Column="1" Content="…" Command="{Binding SetSourcePathCommand}" />
                    </Grid>
                    <TextBlock Margin="0 20 0 0" Text="バックアップ先フォルダ："/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" IsReadOnly="True" Validation.ErrorTemplate="{StaticResource ValidationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="DestinationPath" UpdateSourceTrigger="PropertyChanged" ValidatesOnDataErrors="True">
                                    <Binding.ValidationRules>
                                        <vm:NotUncValidationRule ValidatesOnTargetUpdated="True" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                        <Button Grid.Column="1" Content="…" Command="{Binding SetDestinationPathCommand}" />
                    </Grid>
                    <Separator Margin="0 15 0 10"/>
                    <Expander Header="除外リスト">
                        <Grid Height="150">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <DataGrid Grid.Column="0" IsReadOnly="True" AutoGenerateColumns="False" FontSize="12"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                      CanUserSortColumns="False" SelectionUnit="FullRow" SelectionMode="Single"
                                      RowHeaderWidth="0" VirtualizingPanel.ScrollUnit="Pixel"
                                      ItemsSource="{Binding ExcludeList}" SelectedIndex="{Binding ExcludeListSelectedIndex, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ファイルパス" Width="*" Binding="{Binding FilePath}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Column="1">
                                <Button FontSize="12" Content="Add" Command="{Binding AddItemCommand}" />
                                <Button FontSize="12" Content="Edit" Command="{Binding EditItemCommand}" />
                                <Button FontSize="12" Content="Remove" Command="{Binding RemoveItemCommand}" />
                            </StackPanel>
                        </Grid>

                    </Expander>
                </StackPanel>
                
                
                
 <!--   ++++++++++++++++ Control +++++++++++++++        -->

                <Grid Grid.Row="1" Margin="0 5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20 0">
                        <TextBlock Text="Interval:" />
                        <ComboBox Margin="5 0" Width="70"
                                  ItemsSource="{Binding IntervalCmbSource}"
                                  DisplayMemberPath="Text"
                                  SelectedItem="{Binding SelectedInterval}"
                                  IsEnabled="{Binding IsIntervalCmbEnabled}">
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0 0 5 0"
                            Content="開始" Width="80" Height="80" Command="{Binding BackupRunCommand}"/>
                        <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5 0 0 0"
                            Content="停止" Width="80" Height="80" Command="{Binding StopCommand}"/>
                    </StackPanel>

                </Grid>

            </Grid>
        </DockPanel>
    </Grid>
</Window>
